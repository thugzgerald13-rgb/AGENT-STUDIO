{
  "version": 2,
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/[...all]" },
    { "source": "/v1/(.*)", "destination": "/api/[...all]" },
    { "source": "/webhook/(.*)", "destination": "/api/[...all]" },
    { "source": "/s/(.*)", "destination": "/api/[...all]" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ],
  "functions": {
    "api/[...all].js": { "maxDuration": 60 }
  }
}
