{
  "buildCommand": "npm install",
  "installCommand": "npm install",
  "framework": null,
  "nodeVersion": "24.x",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all].js"
    },
    {
      "source": "/v1/(.*)",
      "destination": "/api/[...all].js"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "/api/[...all].js"
    },
    {
      "source": "/s/(.*)",
      "destination": "/api/[...all].js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/[...all].js"
    }
  ]
}
